# Discord Multi-Agent 환경변수
# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다.
# .env 는 절대 git에 올리지 않는다.

# 채널 ID (디스코드 개발자 모드에서 복사)
# 작업 채널 ID
WORK_CHANNEL_ID=
# 수다 채널 ID
CHAT_CHANNEL_ID=

# 승인 권한자: 내 프로필 오른쪽 클릭 → 사용자 ID 복사
APPROVER_USER_ID=

# 봇 토큰 (Discord Developer Portal → Bot → Reset Token)
# 오케스트레이터 봇 토큰 (스레드 생성용, 비우면 Claude 봇 토큰 사용)
ORCH_BOT_TOKEN=
# 클로드 워커 봇 토큰 (게시용)
CLAUDE_BOT_TOKEN=
# 코덱스 워커 봇 토큰 (게시용)
CODEX_BOT_TOKEN=
# 제미나이 워커 봇 토큰 (게시용)
GEMINI_BOT_TOKEN=

# GY-AI-Router: Codex / Antigravity / Hermes 요청을 받는 별도 봇
# 기존 Claude 봇 토큰을 재사용하지 않는다.
ROUTER_BOT_TOKEN=
# Discord 서버 ID
ROUTER_GUILD_ID=
# 쉼표로 구분. 비우면 APPROVER_USER_ID만 허용한다.
ROUTER_ALLOWED_USER_IDS=
# 쉼표로 구분. 비우면 WORK_CHANNEL_ID와 CHAT_CHANNEL_ID를 사용한다.
ROUTER_ALLOWED_CHANNEL_IDS=
# 쉼표로 구분한 절대 경로. 등록된 저장소 루트만 실행 가능하다.
ROUTER_ALLOWED_REPOS=D:\program\claude_discord
ROUTER_DEFAULT_REPO=D:\program\claude_discord
ROUTER_TIMEOUT_MINUTES=30

# CLI 위치를 자동 탐지하지 못할 때만 지정한다.
CODEX_COMMAND=
AGY_COMMAND=
HERMES_COMMAND=
